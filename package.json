{
  "name": "dsh-session-trash",
  "version": "1.0.0",
  "private": true,
  "description": "Session row actions that move a stored Session to a local trash folder or delete it permanently.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./route": "./route.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "route.js",
    "store.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT"
}
